{
  "name": "@willsoto/nestjs-objection",
  "version": "9.1.0",
  "description": "Objection module for NestJS",
  "keywords": [
    "database",
    "knex",
    "nestjs",
    "objection"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/willsoto/nestjs-objection.git"
  },
  "license": "Apache-2.0",
  "author": "Will Soto <willsoto@users.noreply.github.com> (https://github.com/willsoto)",
  "main": "./dist/index.js",
  "typings": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "prebuild": "npm run clean",
    "build": "tsc --project tsconfig.build.json",
    "clean": "rimraf dist coverage",
    "format": "prettier . --write",
    "lint": "eslint . --fix",
    "prepare": "lefthook install",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "typecheck": "tsc --project tsconfig.lint.json --noEmit"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "10.0.1",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/testing": "12.3.2",
    "@types/node": "24.19.2",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.71.2",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "^17.0.0",
    "knex": "3.3.0",
    "lefthook": "^2.1.4",
    "markdown-toc": "1.2.0",
    "objection": "4.4.2",
    "prettier": "3.9.10",
    "prettier-plugin-organize-imports": "4.3.0",
    "prettier-plugin-packagejson": "3.0.2",
    "reflect-metadata": "0.2.2",
    "rimraf": "6.1.3",
    "rxjs": "7.8.2",
    "sqlite3": "6.0.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "@nestjs/common": "^8.0.0 || ^9.0.0 || ^10.0.0 || ^11.0.0 || ^12.0.0",
    "@nestjs/core": "^8.0.0 || ^9.0.0 || ^10.0.0 || ^11.0.0 || ^12.0.0",
    "knex": "^2.0.0 || ^3.0.0",
    "objection": "^3.0.0 || ^4.0.0"
  },
  "packageManager": "pnpm@12.17.0",
  "volta": {
    "node": "24.22.0",
    "pnpm": "12.17.0"
  }
}
